{
  "info": {
    "name": "Mistral RAG Chatbot - Book Example",
    "description": "Local RAG v0/v1 requests for the rag-faiss educational example.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Index synthetic corpus",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/update-index?type=synthetic"
      }
    },
    {
      "name": "Index PDF corpus",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/update-index?type=pdf"
      }
    },
    {
      "name": "Index DOCX/ODT corpus",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/update-index?type=doc"
      }
    },
    {
      "name": "RAG v0 - vector retrieval",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Which firmware version does Aster-100 require for calibration?\",\n  \"context_type\": \"synthetic\",\n  \"mode\": \"rag_v0\",\n  \"top_k\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/search"
      }
    },
    {
      "name": "RAG v1 - vector retrieval plus reranking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Which firmware version does Aster-100 require for calibration?\",\n  \"context_type\": \"synthetic\",\n  \"mode\": \"rag_v1\",\n  \"top_k\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/search"
      }
    },
    {
      "name": "Unload model",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/clean-resources"
      }
    }
  ]
}
